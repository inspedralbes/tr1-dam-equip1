# Copia aquest fitxer com a .env (al mateix directori) i posa-hi contrasenyes pròpies.
# El .env NO es puja a git.
#   cp .env.example .env
# Per generar una contrasenya segura:  openssl rand -hex 24

DB_NAME=howmuch
