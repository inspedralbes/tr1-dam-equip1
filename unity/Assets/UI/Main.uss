:root {
    flex-grow: 1;
    background-color: #181b22;
}

.main-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 30px;
}

.main-card {
    width: 480px;
    background-color: #242834;
    border-radius: 12px;
    border-width: 1px;
    border-color: #333a4a;
    padding: 32px 36px;
}

.title {
    font-size: 32px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

.field-label {
    font-size: 15px;
    color: #94a3b8;
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 6px;
}

.text-input {
    height: 44px;
    background-color: #1d212b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #333a4a;
    color: #ffffff;
    font-size: 16px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 12px;
    justify-content: center;
}

.text-input:focus {
    border-color: #00bfa5;
}

.text-input > .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: #ffffff;
    font-size: 16px;
    padding: 0;
    -unity-text-align: middle-left;
}

.codi-container {
    flex-direction: column;
}

.crear-container {
    flex-direction: column;
    margin-top: 4px;
    margin-bottom: 8px;
    background-color: #1d212b;
    border-radius: 8px;
    padding: 14px;
    border-width: 1px;
    border-color: #333a4a;
}

.options-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.btn-option {
    flex-grow: 1;
    height: 38px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: #242834;
    border-radius: 6px;
    color: #94a3b8;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: #333a4a;
}

.btn-option:hover {
    background-color: #2e3444;
}

.btn-option.btn-selected {
    background-color: #00bfa5;
    color: #ffffff;
    border-color: #00bfa5;
}

.btn-group {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 18px;
}

.btn {
    flex-grow: 1;
    height: 46px;
    border-radius: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

.btn-secondary {
    background-color: #374151;
    color: #f3f4f6;
    margin-right: 8px;
}

.btn-secondary:hover {
    background-color: #4b5563;
}

.btn-primary {
    background-color: #00bfa5;
    color: #ffffff;
    margin-left: 8px;
}

.btn-primary:hover {
    background-color: #00a892;
}
