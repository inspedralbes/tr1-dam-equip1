:root {
    flex-grow: 1;
    background-color: #181b22;
}

.cat-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 30px;
}

.cat-box {
    width: 860px;
    background-color: #242834;
    border-radius: 12px;
    padding: 30px;
    border-width: 1px;
    border-color: #333a4a;
    align-items: center;
}

.cat-title {
    font-size: 28px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.cat-subtitle {
    font-size: 15px;
    color: #94a3b8;
    margin-bottom: 10px;
}

.voted-label {
    font-size: 14px;
    color: #94a3b8;
    background-color: #1d212b;
    border-width: 1px;
    border-color: #333a4a;
    padding: 6px 16px;
    border-radius: 6px;
    margin-bottom: 16px;
    -unity-font-style: bold;
}

.winner-label {
    font-size: 18px;
    color: #00bfa5;
    background-color: #142926;
    border-width: 1px;
    border-color: #00bfa5;
    padding: 8px 24px;
    border-radius: 6px;
    margin-bottom: 16px;
    -unity-font-style: bold;
}

.grid-container {
    width: 100%;
    flex-direction: column;
}

.row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.cat-btn {
    flex-grow: 1;
    height: 110px;
    margin: 8px;
    background-color: #1d212b;
    color: #ffffff;
    font-size: 19px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 1px;
    border-color: #333a4a;
    white-space: normal;
    -unity-text-align: middle-center;
}

.cat-btn:hover {
    background-color: #282e3d;
    border-color: #475569;
}

.cat-btn:active {
    background-color: #151820;
}

.btn-voted {
    background-color: #1e293b;
    border-color: #38bdf8;
    color: #38bdf8;
    border-width: 2px;
}

.btn-winner {
    background-color: #142926;
    border-color: #00bfa5;
    color: #00bfa5;
    border-width: 2px;
}
