:root {
    flex-grow: 1;
    background-color: #181b22;
}

.lobby-container {
    flex-grow: 1;
    padding: 30px;
    align-items: center;
    justify-content: center;
}

.lobby-box {
    width: 860px;
    height: 580px;
    background-color: #242834;
    border-radius: 12px;
    padding: 25px 30px;
    border-width: 1px;
    border-color: #333a4a;
}

.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #333a4a;
}

.header-left {
    flex-direction: row;
    align-items: center;
}

.lobby-title {
    font-size: 26px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-right: 18px;
}

.code-label {
    font-size: 20px;
    color: #00bfa5;
    background-color: #142926;
    border-width: 1px;
    border-color: #00bfa5;
    padding: 6px 16px;
    border-radius: 6px;
    -unity-font-style: bold;
}

.btn-start {
    height: 44px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #00bfa5;
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
}

.btn-start:hover {
    background-color: #00a892;
}

.participants-title {
    font-size: 17px;
    color: #94a3b8;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.players-scroll {
    flex-grow: 1;
    background-color: #1d212b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #333a4a;
    padding: 16px;
}

.players-wrap-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
}

.player-chip {
    align-items: center;
    justify-content: center;
    background-color: #242834;
    border-width: 1px;
    border-color: #333a4a;
    border-radius: 8px;
    margin: 6px;
    padding: 10px 20px;
}

.player-name {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    white-space: nowrap;
}
