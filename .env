# Credencials de la base de dades de desenvolupament.
# El servei "db" del docker-compose.yml les llegeix directament amb env_file.
MARIADB_ROOT_PASSWORD=root_super_secret
MARIADB_DATABASE=dev_db
MARIADB_USER=dev
MARIADB_PASSWORD=dev
 
# Port de la BDD exposat a la teva màquina (el fa servir el compose per al mapatge de ports)
DB_PORT=3306
 