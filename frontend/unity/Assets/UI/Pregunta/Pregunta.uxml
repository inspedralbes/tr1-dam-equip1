<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pregunta/Pregunta.uss?fileID=7433441132597879392&amp;guid=b8f3521a002774a4fa800b4119d84e20&amp;type=3#Pregunta"/>
    <ui:VisualElement class="pregunta-root">
        <!-- HEADER TOP -->
        <ui:VisualElement class="top-bar">
            <ui:Label text="Nom d'usuari" name="nomLabelPregunta" class="nom-header"/>
            <ui:VisualElement style="flex-grow: 1;"/>
            <ui:Button text="Següent" name="btnSeguent" class="btn btn-next" style="display: none;"/>
            <ui:Button text="NOVA PARTIDA" name="btnNovaPartida" class="btn btn-next" style="display: none;"/>
        </ui:VisualElement>

        <!-- 1. PANTALLA DE PREGUNTA -->
        <ui:VisualElement name="preguntaPanel" class="panel">
            <ui:Label text="Ronda 1 / 5" name="rondaLabel" class="ronda-badge"/>
            
            <ui:VisualElement class="pregunta-card">
                <ui:Label text="Carregant pregunta..." name="textPreguntaLabel" class="pregunta-text"/>
            </ui:VisualElement>

            <ui:VisualElement class="timer-box">
                <ui:Label text="" name="timerLabel" class="timer-text"/>
            </ui:VisualElement>

            <ui:VisualElement class="slider-box">
                <ui:VisualElement class="slider-row">
                    <ui:Label text="0" name="minValLabel" class="val-label-min"/>
                    <ui:Slider name="sliderEstimacio" low-value="0" high-value="100" value="50" class="pregunta-slider"/>
                    <ui:Label text="100" name="maxValLabel" class="val-label-max"/>
                </ui:VisualElement>
                
                <ui:Label text="Estimació: 50" name="estimacioValLabel" class="estimacio-label"/>
                <ui:Button text="Enviar estimació" name="btnEnviarEstimacio" class="btn btn-primary btn-submit"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 2. PANTALLA RESPOSTA -->
        <ui:VisualElement name="respostaPanel" class="panel" style="display: none;">
            <ui:VisualElement class="pregunta-card">
                <ui:Label text="Pregunta..." name="textRespostaPreguntaLabel" class="pregunta-text"/>
                <ui:Label text="Resposta correcta: --" name="correctAnswerLabel" class="correct-text"/>
            </ui:VisualElement>

            <ui:VisualElement class="resposta-main">
                <!-- Escala i marcadors a l'esquerra -->
                <ui:VisualElement class="scale-section">
                    <ui:VisualElement name="markersContainer" class="markers-container"/>
                    <ui:VisualElement name="scaleBar" class="scale-bar"/>
                    <ui:VisualElement class="scale-labels-row">
                        <ui:Label text="0" name="scaleMinLabel" class="scale-min"/>
                        <ui:Label text="100" name="scaleMaxLabel" class="scale-max"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Caixa de posicions de la ronda a la dreta -->
                <ui:VisualElement name="posicionsContainer" class="posicions-card">
                    <ui:Label text="Posicions ronda" class="posicions-title"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3. PANTALLA FINAL (PODIUM) -->
        <ui:VisualElement name="finalPanel" class="panel" style="display: none;">
            <ui:VisualElement class="podium-area">
                <!-- Fila del pòdium (2, 1, 3) -->
                <ui:VisualElement class="podium-row">
                    <!-- 2n lloc -->
                    <ui:VisualElement class="podium-column">
                        <ui:VisualElement class="avatar-circle">
                            <ui:Label text="Avatar" class="avatar-text"/>
                        </ui:VisualElement>
                        <ui:Label text="--" name="p2Name" class="podium-name"/>
                        <ui:Label text="" name="p2Score" class="podium-score"/>
                        <ui:VisualElement class="podium-block podium-2">
                            <ui:Label text="2" class="podium-number"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 1r lloc -->
                    <ui:VisualElement class="podium-column">
                        <ui:VisualElement class="avatar-circle">
                            <ui:Label text="Avatar" class="avatar-text"/>
                        </ui:VisualElement>
                        <ui:Label text="--" name="p1Name" class="podium-name"/>
                        <ui:Label text="" name="p1Score" class="podium-score"/>
                        <ui:VisualElement class="podium-block podium-1">
                            <ui:Label text="1" class="podium-number"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 3r lloc -->
                    <ui:VisualElement class="podium-column">
                        <ui:VisualElement class="avatar-circle">
                            <ui:Label text="Avatar" class="avatar-text"/>
                        </ui:VisualElement>
                        <ui:Label text="--" name="p3Name" class="podium-name"/>
                        <ui:Label text="" name="p3Score" class="podium-score"/>
                        <ui:VisualElement class="podium-block podium-3">
                            <ui:Label text="3" class="podium-number"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 4t i 5è lloc a sota -->
                <ui:VisualElement class="podium-below-row">
                    <ui:VisualElement class="rank-below-box">
                        <ui:Label text="4. --" name="p4Text" class="rank-below-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="rank-below-box">
                        <ui:Label text="5. --" name="p5Text" class="rank-below-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Caixa Puntuació Usuari a sota de tot -->
            <ui:VisualElement class="puntuacio-usuari-card">
                <ui:Label text="Puntuació usuari" name="puntuacioUsuariLabel" class="puntuacio-usuari-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
