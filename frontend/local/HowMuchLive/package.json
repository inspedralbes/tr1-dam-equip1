{
  "name": "howmuch-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "electron:build:linux": "vite build && electron-builder --linux AppImage tar.gz",
    "electron:build:win": "vite build && electron-builder --win portable zip",
    "electron:build:all": "vite build && electron-builder --linux AppImage tar.gz --win portable zip"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "How Much?! LIVE Desktop Client",
  "main": "electron/main.cjs",
  "keywords": [],
  "author": "Equip 1",
  "build": {
    "appId": "cat.equip1.howmuchlive",
    "productName": "How Much LIVE",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "executableName": "howmuch-live"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    }
  }
}
